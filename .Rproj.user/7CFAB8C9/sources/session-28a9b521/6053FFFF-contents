set_time_from_yyyymmdd_names <- function(r) {
  dates <- names(r) |>
    str_extract("\\d{8}") |>
    as.Date(format = "%Y%m%d")
  time(r) <- dates
  r
}

set_time_from_yyyymmdd_names2 <- function(r, rename_layers = TRUE) {
  
  dates <- names(r) |>
    stringr::str_remove("^sst_") |>
    stringr::str_extract("\\d{8}") |>
    as.Date(format = "%Y%m%d")
  
  if (length(dates) != terra::nlyr(r)) {
    stop("Number of extracted dates does not match number of raster layers.")
  }
  
  if (any(is.na(dates))) {
    stop("Some layer names did not contain valid YYYYMMDD dates.")
  }
  
  terra::time(r) <- dates
  
  if (rename_layers) {
    names(r) <- format(dates, "%Y%m%d")
  }
  
  r
}



tidy_monthly <- function(x, metric="mean"){
  dates <- as.Date(time(x))
  xx <- terra::tapp(
    x,
    index = floor_date(dates, "month"),
    fun = metric,
    na.rm = TRUE
  )
  names(xx) <- floor_date(dates, "month") |>
    unique() |>
    format("%Y-%m")
  
  xx

}

